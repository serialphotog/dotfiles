# ls
alias la='ls -A'
alias ll='ls -laF'
alias lsl='ls -lhF'

# cp
alias cp='cp -r'

# mkdir
alias mkdir='mkdir -p'

# Make it easier to reload the config
alias sourceme='source ~/.zshrc'

# Easily get current public IP
alias myip='dig +short myip.opendns.com @resolver1.opendns.com'

# Misc.
alias c='clear'
alias vi='vim'
alias python='python3'
alias pip='python3 -m pip'
